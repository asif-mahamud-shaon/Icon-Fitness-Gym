DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/Icon-Fitness-Gym?schema=public"
PORT=4000
NODE_ENV=production
API_PREFIX=api/v1
CORS_ORIGIN=http://localhost:3000
JWT_ACCESS_SECRET=replace_with_strong_random_48_byte_hex_secret
JWT_REFRESH_SECRET=replace_with_strong_random_48_byte_hex_secret
BIOMETRIC_ENCRYPTION_KEY=replace_with_strong_random_48_byte_hex_secret
BIOMETRIC_HASH_SALT=replace_with_strong_random_32_byte_hex_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=12
ALLOW_DEV_RESET_TOKEN=false
ENABLE_SWAGGER=false
CLOUDINARY_ENABLED=false
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
REDIS_ENABLED=false
REDIS_HOST=localhost
REDIS_PORT=6379
PAYMENT_GATEWAY_ENABLED=false

