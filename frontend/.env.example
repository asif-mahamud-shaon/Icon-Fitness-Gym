# ============================================================================
# ICON FITNESS GYM — FRONTEND ENVIRONMENT TEMPLATE
# Copy to frontend/.env.local for local development or set in hosting dashboard.
# NEVER put private database, JWT, SMTP, or gateway secrets in NEXT_PUBLIC_* vars.
# ============================================================================

NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_GYM_NAME="Icon Fitness Gym"
NEXT_PUBLIC_GYM_LOCATION="Ashkona, Dakshinkhan, Dhaka, Bangladesh"

# Optional server-side SSR API URL (not exposed to browser bundle)
# INTERNAL_API_URL=http://localhost:4000/api/v1
