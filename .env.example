# ============================================================================
# ICON FITNESS GYM — ROOT ENVIRONMENT CONFIGURATION TEMPLATE
# Copy corresponding sections to backend/.env and frontend/.env.local
# Never commit real .env files to version control.
# ============================================================================

# --- PostgreSQL Database ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=YOUR_DB_PASSWORD_HERE
POSTGRES_DB=Icon-Fitness-Gym
POSTGRES_PORT=5432
DATABASE_URL="postgresql://postgres:YOUR_DB_PASSWORD_HERE@localhost:5432/Icon-Fitness-Gym?schema=public"

# --- Backend Application ---
PORT=4000
NODE_ENV=production
API_PREFIX=api/v1
CORS_ORIGIN=http://localhost:3000
ALLOW_DEV_RESET_TOKEN=false
ENABLE_SWAGGER=false

# --- JWT & Authentication ---
JWT_ACCESS_SECRET=replace_with_strong_random_64_byte_hex_secret_for_access_token
JWT_REFRESH_SECRET=replace_with_strong_random_64_byte_hex_secret_for_refresh_token
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=12

# --- Redis (Optional Caching & Queue Layer) ---
REDIS_ENABLED=false
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# --- Cloudinary (Image & Video Management Placeholder) ---
CLOUDINARY_ENABLED=false
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# --- Payment Gateway Configuration (Manual verification active by default) ---
PAYMENT_GATEWAY_ENABLED=false
SSLCOMMERZ_STORE_ID=your_store_id
SSLCOMMERZ_STORE_PASSWD=your_store_password
SSLCOMMERZ_IS_LIVE=false

# --- Frontend Public Configuration ---
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_GYM_NAME="Icon Fitness Gym"
NEXT_PUBLIC_GYM_LOCATION="Ashkona, Dakshinkhan, Dhaka, Bangladesh"


# --- Smart Access Control & Biometric Security ---
BIOMETRIC_ENCRYPTION_KEY=replace_with_strong_random_48_byte_hex_secret_for_aes_256_gcm_biometric_templates
BIOMETRIC_HASH_SALT=replace_with_strong_random_32_byte_hex_salt_for_template_hmac
TZ=Asia/Dhaka
